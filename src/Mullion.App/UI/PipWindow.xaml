<Window x:Class="Mullion.App.UI.PipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mullion picture-in-picture"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Background="#FF1B1E26" MinWidth="160" MinHeight="100"
        WindowStartupLocation="Manual" Left="-32000" Top="-32000" Width="320" Height="200"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <!-- DWM paints the thumbnail on top of everything in its destination rectangle, so the caption strip
         keeps its own row above it. No AllowsTransparency here: thumbnails do not render on layered windows. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="Caption" Background="{StaticResource Mullion.Surface}" MouseLeftButtonDown="OnCaptionMouseDown">
            <DockPanel>
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource Mullion.ToolButton}"
                        Content="&#x2715;" FontSize="10" MinWidth="24" Padding="6,0"
                        ToolTip="Close this view (the original window stays where it is)" Click="OnClose" />
                <Button x:Name="OpenButton" DockPanel.Dock="Right" Style="{StaticResource Mullion.ToolButton}"
                        Content="Open" FontSize="11" Padding="6,0"
                        ToolTip="Bring the original window to the front" Click="OnOpen" />
                <TextBlock x:Name="TitleText" Foreground="{StaticResource Mullion.Text}" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,4,0" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Border x:Name="ThumbnailArea" Grid.Row="1" Background="Transparent" Cursor="Hand"
                MouseLeftButtonDown="OnThumbnailMouseDown"
                ToolTip="Click to bring the original window back to the front" />
    </Grid>
</Window>
