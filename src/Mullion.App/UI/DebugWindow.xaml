<Window x:Class="Mullion.App.UI.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mullion debug console"
        Width="760" Height="520" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="270" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Padding="10,2" Click="OnRefresh" />
            <CheckBox x:Name="IncludeOwnCheck" DockPanel.Dock="Right" Content="Include Mullion's windows" Margin="0,0,10,0"
                      VerticalAlignment="Center" Checked="OnIncludeOwnChanged" Unchecked="OnIncludeOwnChanged" />
            <TextBlock Text="Eligible top-level windows" VerticalAlignment="Center" FontWeight="SemiBold" />
        </DockPanel>

        <ListBox x:Name="WindowList" Grid.Row="1" Grid.Column="0" Margin="0,6,0,0"
                 DisplayMemberPath="Display" SelectionChanged="OnSelectionChanged" />

        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2">
            <TextBlock x:Name="TargetText" Text="Select a window on the left." TextWrapping="Wrap" FontWeight="SemiBold" />
            <Button x:Name="TopmostButton" Content="Pin always on top" Margin="0,10,0,0" Padding="6,4" Click="OnToggleTopmost" />
            <TextBlock Text="Opacity" Margin="0,12,0,0" />
            <DockPanel>
                <TextBlock x:Name="OpacityLabel" DockPanel.Dock="Right" Width="44" TextAlignment="Right" Text="100%" VerticalAlignment="Center" />
                <Slider x:Name="OpacitySlider" Minimum="10" Maximum="100" Value="100" TickFrequency="10"
                        IsSnapToTickEnabled="True" ValueChanged="OnOpacityChanged" />
            </DockPanel>
            <Button x:Name="ClickThroughButton" Content="Click-through: off" Margin="0,10,0,0" Padding="6,4" Click="OnToggleClickThrough" />
            <Button x:Name="PipButton" Content="Picture-in-picture" Margin="0,6,0,0" Padding="6,4" Click="OnPip" />
            <Button x:Name="RestoreButton" Content="Restore this window" Margin="0,6,0,0" Padding="6,4" Click="OnRestore" />
            <Button x:Name="RestoreAllButton" Content="Restore all" Margin="0,6,0,0" Padding="6,4" Click="OnRestoreAll" />
            <TextBlock Text="Modified windows" Margin="0,14,0,4" FontWeight="SemiBold" />
            <ItemsControl x:Name="TrackedList" />
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="Log" Margin="0,8,0,2" FontWeight="SemiBold" />
        <TextBox x:Name="LogBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="Wrap" />
    </Grid>
</Window>
