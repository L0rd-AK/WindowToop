<Window x:Class="Mullion.App.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mullion settings"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="HotkeyBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="False" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="Click here, then press the key combination you want." />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Text="Hotkeys" FontWeight="SemiBold" FontSize="14" />
        <TextBlock Text="Click a box and press a combination. Every hotkey acts on the window that currently has focus."
                   TextWrapping="Wrap" Foreground="#666" Margin="0,2,0,8" />

        <Grid x:Name="HotkeyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Toggle always on top" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TopmostBox" Style="{StaticResource HotkeyBox}" Margin="0,3" PreviewKeyDown="OnHotkeyKeyDown" />
            <Button Grid.Row="0" Grid.Column="2" Content="Clear" Margin="6,3,0,3" Padding="8,2" Tag="{Binding ElementName=TopmostBox}" Click="OnClearHotkey" />

            <TextBlock Grid.Row="1" Text="Opacity up" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="OpacityUpBox" Style="{StaticResource HotkeyBox}" Margin="0,3" PreviewKeyDown="OnHotkeyKeyDown" />
            <Button Grid.Row="1" Grid.Column="2" Content="Clear" Margin="6,3,0,3" Padding="8,2" Tag="{Binding ElementName=OpacityUpBox}" Click="OnClearHotkey" />

            <TextBlock Grid.Row="2" Text="Opacity down" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="OpacityDownBox" Style="{StaticResource HotkeyBox}" Margin="0,3" PreviewKeyDown="OnHotkeyKeyDown" />
            <Button Grid.Row="2" Grid.Column="2" Content="Clear" Margin="6,3,0,3" Padding="8,2" Tag="{Binding ElementName=OpacityDownBox}" Click="OnClearHotkey" />

            <TextBlock Grid.Row="3" Text="Toggle click-through" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="ClickThroughBox" Style="{StaticResource HotkeyBox}" Margin="0,3" PreviewKeyDown="OnHotkeyKeyDown" />
            <Button Grid.Row="3" Grid.Column="2" Content="Clear" Margin="6,3,0,3" Padding="8,2" Tag="{Binding ElementName=ClickThroughBox}" Click="OnClearHotkey" />

            <TextBlock Grid.Row="4" Text="Picture-in-picture" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="PipBox" Style="{StaticResource HotkeyBox}" Margin="0,3" PreviewKeyDown="OnHotkeyKeyDown" />
            <Button Grid.Row="4" Grid.Column="2" Content="Clear" Margin="6,3,0,3" Padding="8,2" Tag="{Binding ElementName=PipBox}" Click="OnClearHotkey" />
        </Grid>

        <TextBlock x:Name="ValidationText" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

        <TextBlock Text="Behaviour" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,6" />
        <CheckBox x:Name="ToolbarCheck" Content="Show the floating toolbar when the mouse rests on a window's title bar" Margin="0,2" />
        <DockPanel Margin="0,6,0,0">
            <TextBlock Text="Opacity hotkey step" VerticalAlignment="Center" Width="170" />
            <ComboBox x:Name="StepCombo" Width="90" HorizontalAlignment="Left" SelectedValuePath="Tag">
                <ComboBoxItem Content="5%" Tag="5" />
                <ComboBoxItem Content="10%" Tag="10" />
                <ComboBoxItem Content="15%" Tag="15" />
                <ComboBoxItem Content="20%" Tag="20" />
                <ComboBoxItem Content="25%" Tag="25" />
            </ComboBox>
        </DockPanel>
        <CheckBox x:Name="PipAwakeCheck" Margin="0,8,0,0">
            <TextBlock TextWrapping="Wrap" Width="390"
                       Text="Keep picture-in-picture live: hide the original window while its view is open, so browsers don't pause video when other windows cover it" />
        </CheckBox>
        <CheckBox x:Name="StartupCheck" Content="Start Mullion when I sign in to Windows" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Save" Width="84" Padding="0,4" IsDefault="True" Click="OnSave" />
            <Button Content="Cancel" Width="84" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
